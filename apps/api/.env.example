# FastAPI Backend Environment Variables
# Copy to .env and configure for your environment

# ==================== REQUIRED ====================

# Database Connection (PostgreSQL with async support)
DATABASE_URL=postgresql+asyncpg://opencut:opencut@localhost:5432/opencut

# JWT Authentication (change for production!)
JWT_SECRET=your_super_secret_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# CORS Configuration (comma-separated, frontend URLs)
# Development: Include localhost variations
# Production: Include your production domains
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ==================== OPTIONAL ====================
# Features gracefully disabled without these API keys

# Audio Services
FREESOUND_API_KEY=
ELEVENLABS_API_KEY=

# AI Providers
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_AI_API_KEY=

# Music Generation
SUNO_API_KEY=
SUNO_API_URL=

# Stock Media
PEXELS_API_KEY=
PIXABAY_API_KEY=
