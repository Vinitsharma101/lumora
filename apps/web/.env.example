# Environment variables example
# Copy this file to .env.local and update the values as needed

# Node
NODE_ENV=development

# Public
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com

# Optional: Freesound API
FREESOUND_CLIENT_ID=your_client_id_here
FREESOUND_API_KEY=your_api_key_here

# ⚠️  BACKEND CONFIGURATION - Use apps/api/.env instead!
# ================================================================
# The following should NOT be in the frontend (.env.local):
#
# Database credentials (DATABASE_URL, etc.)
# Authentication secrets (BETTER_AUTH_SECRET, JWT_SECRET, etc.)
# Redis credentials (UPSTASH_REDIS_*, REDIS_URL, etc.)
# Cloud storage (CLOUDFLARE_*, R2_*, etc.)
# AI Provider keys (ANTHROPIC_API_KEY, OPENAI_API_KEY, etc.)
# External services (ELEVENLABS_API_KEY, SUNO_API_KEY, etc.)
#
# All backend secrets belong in: apps/api/.env
# See API_COMMUNICATION.md for complete setup guide